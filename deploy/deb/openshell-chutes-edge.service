[Unit]
Description=OpenShell Chutes Edge
Documentation=https://github.com/NVIDIA/OpenShell
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The edge keeps no state and owns no files, so it runs from an unprivileged
# ephemeral account. Its Chutes API key is the only input it needs; it is read
# from the environment file below rather than from the unit so the key never
# lands in a world-readable drop-in.
DynamicUser=yes
EnvironmentFile=-/etc/openshell/chutes-edge.env
ExecStart=/usr/bin/openshell-chutes-edge
Restart=on-failure
RestartSec=5s
# The HTTP server traps SIGINT for a graceful shutdown and ignores SIGTERM, so
# without this every stop or restart waits out the default 90s stop timeout.
KillSignal=SIGINT

# Security hardening. The edge needs no privileges at all: it binds an
# unprivileged port, opens sockets, and reads its environment file.
NoNewPrivileges=yes
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
